# ── AI Provider ──────────────────────────────────
# MOCK_MODE=true   → regex-based, no API key needed (for testing)
# MOCK_MODE=false  → use real AI provider below
MOCK_MODE=true

# Options: gemini, openai, anthropic, ollama
AI_PROVIDER=gemini

# API Keys (only needed when MOCK_MODE=false)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── Database ────────────────────────────────────
DATABASE_URL=sqlite:///./meetings.db

# ── Security ────────────────────────────────────
# API key for endpoint authentication (optional).
# If empty, auth is DISABLED (dev mode only).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── Integrations (optional) ─────────────────────
LINEAR_API_KEY=your_linear_key_here
